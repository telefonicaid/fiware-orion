# VALGRIND_READY - to mark the test ready for valgrindTestSuite.sh
# JEXL_EXPR_FLAVOUR - to mark the test has to execute only when contextBroker includes jexl-expr flavour


--NAME--
Context references with macro errors, null and empty values in id or type

--SHELL-INIT--
dbInit CB
brokerStart CB
accumulatorStart --pretty-print

--SHELL--

#
# 01. Create entity E2/T2 with A=1
# 02. Create custom sub with contextReferences E2/T2, ${refId/T2 (macro error), E2/${nonExistingAttr} (null) and ${emptyAttr}/T2 (empty)
# 03. Create entity E with refId=E2 and emptyAttr=''
# 04. Dump accumulator and see one notification with r0={E2/T2}, r1=null, r2=null, r3=null
#


echo "01. Create entity E2/T2 with A=1"
echo "================================"
payload='{
  "id": "E2",
  "type": "T2",
  "A": {
    "value": 1,
    "type": "Number"
  }
}'
orionCurl --url /v2/entities --payload "$payload"
echo
echo


echo "02. Create custom sub with contextReferences E2/T2, \${refId/T2 (macro error), E2/\${nonExistingAttr} (null) and \${emptyAttr}/T2 (empty)"
echo "======================================================================================================================================"
payload='{
  "subject": {
    "entities": [
      {
        "id": "E",
        "type": "T"
      }
    ]
  },
  "notification": {
    "httpCustom": {
      "url": "http://127.0.0.1:'${LISTENER_PORT}'/notify",
      "contextReferences": [
        { "id": "E2", "type": "T2" },
        { "id": "${refId", "type": "T2" },
        { "id": "E2", "type": "${nonExistingAttr}" },
        { "id": "${emptyAttr}", "type": "T2" }
      ],
      "json": {
        "r0": "${contextReferences[0]}",
        "r1": "${contextReferences[1]}",
        "r2": "${contextReferences[2]}",
        "r3": "${contextReferences[3]}"
      }
    }
  }
}'
orionCurl --url /v2/subscriptions --payload "$payload"
echo
echo


echo "03. Create entity E with refId=E2 and emptyAttr=''"
echo "=================================================="
payload='{
  "id": "E",
  "type": "T",
  "refId": {
    "value": "E2",
    "type": "Text"
  },
  "emptyAttr": {
    "value": "",
    "type": "Text"
  }
}'
orionCurl --url /v2/entities --payload "$payload"
echo
echo


echo "04. Dump accumulator and see one notification with r0={E2/T2}, r1=null, r2=null, r3=null"
echo "========================================================================================"
accumulatorDump
echo
echo


--REGEXPECT--
01. Create entity E2/T2 with A=1
================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Fiware-Correlator: REGEX([0-9a-f\-]{36})
Location: /v2/entities/E2?type=T2
Content-Length: 0



02. Create custom sub with contextReferences E2/T2, ${refId/T2 (macro error), E2/${nonExistingAttr} (null) and ${emptyAttr}/T2 (empty)
======================================================================================================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Fiware-Correlator: REGEX([0-9a-f\-]{36})
Location: /v2/subscriptions/REGEX([0-9a-f]{24})
Content-Length: 0



03. Create entity E with refId=E2 and emptyAttr=''
==================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Fiware-Correlator: REGEX([0-9a-f\-]{36})
Location: /v2/entities/E?type=T
Content-Length: 0



04. Dump accumulator and see one notification with r0={E2/T2}, r1=null, r2=null, r3=null
========================================================================================
POST http://127.0.0.1:REGEX(\d+)/notify
Fiware-Servicepath: /
Content-Length: 66
User-Agent: orion/REGEX(\d+\.\d+\.\d+.*)
Ngsiv2-Attrsformat: custom
Host: 127.0.0.1:REGEX(\d+)
Accept: application/json
Content-Type: application/json; charset=utf-8
Fiware-Correlator: REGEX([0-9a-f\-]{36}); cbnotif=1

{
    "r0": {
        "A": 1,
        "id": "E2",
        "type": "T2"
    },
    "r1": null,
    "r2": null,
    "r3": null
}
=======================================


--TEARDOWN--
brokerStop CB
dbDrop CB
accumulatorStop
