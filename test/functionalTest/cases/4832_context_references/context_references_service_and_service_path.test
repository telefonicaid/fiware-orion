# VALGRIND_READY - to mark the test ready for valgrindTestSuite.sh
# JEXL_EXPR_FLAVOUR - to mark the test has to execute only when contextBroker includes jexl-expr flavour

--NAME--
Context references are searched in the same service and servicePath of the notified entity

--SHELL-INIT--
dbInit CB
dbInit CB s1
dbInit CB s2
brokerStart CB 0 IPV4 -multiservice
accumulatorStart --pretty-print

--SHELL--

#
# 01. Create entity E2/T2 with A=1 in service s1 and servicePath /A
# 02. Create entity E2/T2 with A=2 in service s1 and servicePath /B
# 03. Create entity E3/T3 with A=3 in service s2 and servicePath /A
# 04. Create custom sub in service s1 and servicePath /# with contextReferences E2/T2 and E3/T3
# 05. Create entity E/T in service s1 and servicePath /A
# 06. Create entity E/T in service s1 and servicePath /B
# 07. Create entity E/T in service s1 and servicePath /C
# 08. Dump accumulator and see three notifications
#     first:  r0={E2/T2 A=1}, r1=null (E3/T3 is in other service)
#     second: r0={E2/T2 A=2}, r1=null (E3/T3 is in other service)
#     third:  r0=null (no E2/T2 in servicePath /C), r1=null (E3/T3 is in other service)
#


echo "01. Create entity E2/T2 with A=1 in service s1 and servicePath /A"
echo "================================================================="
payload='{
  "id": "E2",
  "type": "T2",
  "A": {
    "value": 1,
    "type": "Number"
  }
}'
orionCurl --url /v2/entities --payload "$payload" --tenant s1 --servicePath /A
echo
echo


echo "02. Create entity E2/T2 with A=2 in service s1 and servicePath /B"
echo "================================================================="
payload='{
  "id": "E2",
  "type": "T2",
  "A": {
    "value": 2,
    "type": "Number"
  }
}'
orionCurl --url /v2/entities --payload "$payload" --tenant s1 --servicePath /B
echo
echo


echo "03. Create entity E3/T3 with A=3 in service s2 and servicePath /A"
echo "================================================================="
payload='{
  "id": "E3",
  "type": "T3",
  "A": {
    "value": 3,
    "type": "Number"
  }
}'
orionCurl --url /v2/entities --payload "$payload" --tenant s2 --servicePath /A
echo
echo


echo "04. Create custom sub in service s1 and servicePath /# with contextReferences E2/T2 and E3/T3"
echo "============================================================================================="
payload='{
  "subject": {
    "entities": [
      {
        "id": "E",
        "type": "T"
      }
    ]
  },
  "notification": {
    "httpCustom": {
      "url": "http://127.0.0.1:'${LISTENER_PORT}'/notify",
      "contextReferences": [
        { "id": "E2", "type": "T2" },
        { "id": "E3", "type": "T3" }
      ],
      "json": {
        "r0": "${contextReferences[0]}",
        "r1": "${contextReferences[1]}"
      }
    }
  }
}'
orionCurl --url /v2/subscriptions --payload "$payload" --tenant s1 --servicePath /#
echo
echo


echo "05. Create entity E/T in service s1 and servicePath /A"
echo "======================================================"
payload='{
  "id": "E",
  "type": "T",
  "A": {
    "value": 10,
    "type": "Number"
  }
}'
orionCurl --url /v2/entities --payload "$payload" --tenant s1 --servicePath /A
echo
echo


echo "06. Create entity E/T in service s1 and servicePath /B"
echo "======================================================"
payload='{
  "id": "E",
  "type": "T",
  "A": {
    "value": 20,
    "type": "Number"
  }
}'
orionCurl --url /v2/entities --payload "$payload" --tenant s1 --servicePath /B
echo
echo


echo "07. Create entity E/T in service s1 and servicePath /C"
echo "======================================================"
payload='{
  "id": "E",
  "type": "T",
  "A": {
    "value": 30,
    "type": "Number"
  }
}'
orionCurl --url /v2/entities --payload "$payload" --tenant s1 --servicePath /C
echo
echo


echo "08. Dump accumulator and see three notifications"
echo "================================================"
accumulatorDump
echo
echo


--REGEXPECT--
01. Create entity E2/T2 with A=1 in service s1 and servicePath /A
=================================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Fiware-Correlator: REGEX([0-9a-f\-]{36})
Location: /v2/entities/E2?type=T2
Content-Length: 0



02. Create entity E2/T2 with A=2 in service s1 and servicePath /B
=================================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Fiware-Correlator: REGEX([0-9a-f\-]{36})
Location: /v2/entities/E2?type=T2
Content-Length: 0



03. Create entity E3/T3 with A=3 in service s2 and servicePath /A
=================================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Fiware-Correlator: REGEX([0-9a-f\-]{36})
Location: /v2/entities/E3?type=T3
Content-Length: 0



04. Create custom sub in service s1 and servicePath /# with contextReferences E2/T2 and E3/T3
=============================================================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Fiware-Correlator: REGEX([0-9a-f\-]{36})
Location: /v2/subscriptions/REGEX([0-9a-f]{24})
Content-Length: 0



05. Create entity E/T in service s1 and servicePath /A
======================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Fiware-Correlator: REGEX([0-9a-f\-]{36})
Location: /v2/entities/E?type=T
Content-Length: 0



06. Create entity E/T in service s1 and servicePath /B
======================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Fiware-Correlator: REGEX([0-9a-f\-]{36})
Location: /v2/entities/E?type=T
Content-Length: 0



07. Create entity E/T in service s1 and servicePath /C
======================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Fiware-Correlator: REGEX([0-9a-f\-]{36})
Location: /v2/entities/E?type=T
Content-Length: 0



08. Dump accumulator and see three notifications
================================================
POST http://127.0.0.1:REGEX(\d+)/notify
Fiware-Servicepath: /A
Content-Length: 46
User-Agent: orion/REGEX(\d+\.\d+\.\d+.*)
Ngsiv2-Attrsformat: custom
Host: 127.0.0.1:REGEX(\d+)
Accept: application/json
Fiware-Service: s1
Content-Type: application/json; charset=utf-8
Fiware-Correlator: REGEX([0-9a-f\-]{36}); cbnotif=1

{
    "r0": {
        "A": 1,
        "id": "E2",
        "type": "T2"
    },
    "r1": null
}
=======================================
POST http://127.0.0.1:REGEX(\d+)/notify
Fiware-Servicepath: /B
Content-Length: 46
User-Agent: orion/REGEX(\d+\.\d+\.\d+.*)
Ngsiv2-Attrsformat: custom
Host: 127.0.0.1:REGEX(\d+)
Accept: application/json
Fiware-Service: s1
Content-Type: application/json; charset=utf-8
Fiware-Correlator: REGEX([0-9a-f\-]{36}); cbnotif=1

{
    "r0": {
        "A": 2,
        "id": "E2",
        "type": "T2"
    },
    "r1": null
}
=======================================
POST http://127.0.0.1:REGEX(\d+)/notify
Fiware-Servicepath: /C
Content-Length: 21
User-Agent: orion/REGEX(\d+\.\d+\.\d+.*)
Ngsiv2-Attrsformat: custom
Host: 127.0.0.1:REGEX(\d+)
Accept: application/json
Fiware-Service: s1
Content-Type: application/json; charset=utf-8
Fiware-Correlator: REGEX([0-9a-f\-]{36}); cbnotif=1

{
    "r0": null,
    "r1": null
}
=======================================


--TEARDOWN--
brokerStop CB
dbDrop CB
dbDrop CB s1
dbDrop CB s2
accumulatorStop
