# VALGRIND_READY - to mark the test ready for valgrindTestSuite.sh

--NAME--
Context references parsing errors

--SHELL-INIT--
dbInit CB
brokerStart CB

--SHELL--

#
# 01. Create httpCustom sub with contextReferences not an array, see error
# 02. Create httpCustom sub with contextReferences empty, see error
# 03. Create httpCustom sub with contextReferences item not an object, see error
# 04. Create httpCustom sub with contextReferences item without id, see error
# 05. Create httpCustom sub with contextReferences item with id not a string, see error
# 06. Create httpCustom sub with contextReferences item with empty id, see error
# 07. Create httpCustom sub with contextReferences item without type, see error
# 08. Create httpCustom sub with contextReferences item with type not a string, see error
# 09. Create httpCustom sub with contextReferences item with empty type, see error
# 10. Create httpCustom sub with contextReferences item with unknown field, see error
# 11. Create mqttCustom sub with contextReferences not an array, see error
# 12. Create mqttCustom sub with contextReferences item without type, see error
# 13. Create kafkaCustom sub with contextReferences empty, see error
# 14. Create kafkaCustom sub with contextReferences item not an object, see error
#


echo "01. Create httpCustom sub with contextReferences not an array, see error"
echo "========================================================================"
payload='{
  "subject": {
    "entities": [
      {
        "id": "E",
        "type": "T"
      }
    ]
  },
  "notification": {
    "httpCustom": {
      "url": "http://127.0.0.1:'${LISTENER_PORT}'/notify",
      "contextReferences": { "id": "E2", "type": "T2" }
    }
  }
}'
orionCurl --url /v2/subscriptions --payload "$payload"
echo
echo


echo "02. Create httpCustom sub with contextReferences empty, see error"
echo "================================================================="
payload='{
  "subject": {
    "entities": [
      {
        "id": "E",
        "type": "T"
      }
    ]
  },
  "notification": {
    "httpCustom": {
      "url": "http://127.0.0.1:'${LISTENER_PORT}'/notify",
      "contextReferences": [ ]
    }
  }
}'
orionCurl --url /v2/subscriptions --payload "$payload"
echo
echo


echo "03. Create httpCustom sub with contextReferences item not an object, see error"
echo "=============================================================================="
payload='{
  "subject": {
    "entities": [
      {
        "id": "E",
        "type": "T"
      }
    ]
  },
  "notification": {
    "httpCustom": {
      "url": "http://127.0.0.1:'${LISTENER_PORT}'/notify",
      "contextReferences": [ "E2" ]
    }
  }
}'
orionCurl --url /v2/subscriptions --payload "$payload"
echo
echo


echo "04. Create httpCustom sub with contextReferences item without id, see error"
echo "==========================================================================="
payload='{
  "subject": {
    "entities": [
      {
        "id": "E",
        "type": "T"
      }
    ]
  },
  "notification": {
    "httpCustom": {
      "url": "http://127.0.0.1:'${LISTENER_PORT}'/notify",
      "contextReferences": [ { "type": "T2" } ]
    }
  }
}'
orionCurl --url /v2/subscriptions --payload "$payload"
echo
echo


echo "05. Create httpCustom sub with contextReferences item with id not a string, see error"
echo "====================================================================================="
payload='{
  "subject": {
    "entities": [
      {
        "id": "E",
        "type": "T"
      }
    ]
  },
  "notification": {
    "httpCustom": {
      "url": "http://127.0.0.1:'${LISTENER_PORT}'/notify",
      "contextReferences": [ { "id": 1, "type": "T2" } ]
    }
  }
}'
orionCurl --url /v2/subscriptions --payload "$payload"
echo
echo


echo "06. Create httpCustom sub with contextReferences item with empty id, see error"
echo "=============================================================================="
payload='{
  "subject": {
    "entities": [
      {
        "id": "E",
        "type": "T"
      }
    ]
  },
  "notification": {
    "httpCustom": {
      "url": "http://127.0.0.1:'${LISTENER_PORT}'/notify",
      "contextReferences": [ { "id": "", "type": "T2" } ]
    }
  }
}'
orionCurl --url /v2/subscriptions --payload "$payload"
echo
echo


echo "07. Create httpCustom sub with contextReferences item without type, see error"
echo "============================================================================="
payload='{
  "subject": {
    "entities": [
      {
        "id": "E",
        "type": "T"
      }
    ]
  },
  "notification": {
    "httpCustom": {
      "url": "http://127.0.0.1:'${LISTENER_PORT}'/notify",
      "contextReferences": [ { "id": "E2" } ]
    }
  }
}'
orionCurl --url /v2/subscriptions --payload "$payload"
echo
echo


echo "08. Create httpCustom sub with contextReferences item with type not a string, see error"
echo "======================================================================================="
payload='{
  "subject": {
    "entities": [
      {
        "id": "E",
        "type": "T"
      }
    ]
  },
  "notification": {
    "httpCustom": {
      "url": "http://127.0.0.1:'${LISTENER_PORT}'/notify",
      "contextReferences": [ { "id": "E2", "type": true } ]
    }
  }
}'
orionCurl --url /v2/subscriptions --payload "$payload"
echo
echo


echo "09. Create httpCustom sub with contextReferences item with empty type, see error"
echo "================================================================================"
payload='{
  "subject": {
    "entities": [
      {
        "id": "E",
        "type": "T"
      }
    ]
  },
  "notification": {
    "httpCustom": {
      "url": "http://127.0.0.1:'${LISTENER_PORT}'/notify",
      "contextReferences": [ { "id": "E2", "type": "" } ]
    }
  }
}'
orionCurl --url /v2/subscriptions --payload "$payload"
echo
echo


echo "10. Create httpCustom sub with contextReferences item with unknown field, see error"
echo "==================================================================================="
payload='{
  "subject": {
    "entities": [
      {
        "id": "E",
        "type": "T"
      }
    ]
  },
  "notification": {
    "httpCustom": {
      "url": "http://127.0.0.1:'${LISTENER_PORT}'/notify",
      "contextReferences": [ { "id": "E2", "type": "T2", "foo": "bar" } ]
    }
  }
}'
orionCurl --url /v2/subscriptions --payload "$payload"
echo
echo


echo "11. Create mqttCustom sub with contextReferences not an array, see error"
echo "========================================================================"
payload='{
  "subject": {
    "entities": [
      {
        "id": "E",
        "type": "T"
      }
    ]
  },
  "notification": {
    "mqttCustom": {
      "url": "mqtt://localhost:1883",
      "topic": "sub1",
      "contextReferences": "E2"
    }
  }
}'
orionCurl --url /v2/subscriptions --payload "$payload"
echo
echo


echo "12. Create mqttCustom sub with contextReferences item without type, see error"
echo "============================================================================="
payload='{
  "subject": {
    "entities": [
      {
        "id": "E",
        "type": "T"
      }
    ]
  },
  "notification": {
    "mqttCustom": {
      "url": "mqtt://localhost:1883",
      "topic": "sub1",
      "contextReferences": [ { "id": "E2", "type": "T2" }, { "id": "E3" } ]
    }
  }
}'
orionCurl --url /v2/subscriptions --payload "$payload"
echo
echo


echo "13. Create kafkaCustom sub with contextReferences empty, see error"
echo "=================================================================="
payload='{
  "subject": {
    "entities": [
      {
        "id": "E",
        "type": "T"
      }
    ]
  },
  "notification": {
    "kafkaCustom": {
      "url": "kafka://localhost:9092",
      "topic": "sub1",
      "contextReferences": [ ]
    }
  }
}'
orionCurl --url /v2/subscriptions --payload "$payload"
echo
echo


echo "14. Create kafkaCustom sub with contextReferences item not an object, see error"
echo "==============================================================================="
payload='{
  "subject": {
    "entities": [
      {
        "id": "E",
        "type": "T"
      }
    ]
  },
  "notification": {
    "kafkaCustom": {
      "url": "kafka://localhost:9092",
      "topic": "sub1",
      "contextReferences": [ { "id": "E2", "type": "T2" }, [ "E3", "T3" ] ]
    }
  }
}'
orionCurl --url /v2/subscriptions --payload "$payload"
echo
echo


--REGEXPECT--
01. Create httpCustom sub with contextReferences not an array, see error
========================================================================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Fiware-Correlator: REGEX([0-9a-f\-]{36})
Content-Type: application/json
Content-Length: 96

{
    "description": "notification httpCustom contextReferences is not an array",
    "error": "BadRequest"
}


02. Create httpCustom sub with contextReferences empty, see error
=================================================================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Fiware-Correlator: REGEX([0-9a-f\-]{36})
Content-Type: application/json
Content-Length: 89

{
    "description": "notification httpCustom contextReferences is empty",
    "error": "BadRequest"
}


03. Create httpCustom sub with contextReferences item not an object, see error
==============================================================================
HTTP/1.1 400 Bad Request
Date: REGEX(.*)
Fiware-Correlator: REGEX([0-9a-f\-]{36})
Content-Type: application/json
Content-Length: 102

{
    "description": "notification httpCustom contextReferences item is not an object",
    "error": "BadRequest"
}


04. Create httpCustom sub with contextReferences item without id, see error
