# VALGRIND_READY - to mark the test ready for valgrindTestSuite.sh

--NAME--
Covered subscription combined with onlyChangedAttrs

--SHELL-INIT--
dbInit CB
brokerStart CB 0 IPv4 -subCacheIval 1
accumulatorStart --pretty-print

--SHELL--

#
# NOTE: subscription updates takes its time to propagate into csubs cache. Thus, we have introduced
# some sleep (=1.5*subCacheIval). These sleeps are not needed if this tests is run with --noCache flag
#
# 01. Create entity E-T with A, B
# 02. Create subscription for A, B, C, D with covered:true and onlyChangedAttrs:false
# 03. Update E-T with A=11
# 04. Dump & reset, see notifications A=11, B=2, C=null, D=null (context is not lost)
# 05. Update subscription to A, B, C, D with covered:true and onlyChangedAttrs:true
# 06. Update E-T with A=111
# 07. Dump & reset, see notifications A=111, B=2, C=null, D=null (context is not lost)
# 08. Update subscription to A, B, C, D with covered:false and onlyChangedAttrs:true
# 09. Update E-T with A=1111
# 10. Dump & reset, see notifications A=1111, B=2, C=null, D=null (context is not lost)
# 11. Update subscription to A, B, C, D with covered:false and onlyChangedAttrs:false
# 12. Update E-T with A=11111
# 13. Dump & reset, see notifications A=11111, B=2, C=null, D=null (context is not lost)
#

echo "01. Create entity E-T with A, B"
echo "==============================="
payload='{
  "id": "E",
  "type": "T",
  "A": {
    "value": 1,
    "type": "Number"
  },
  "B": {
    "value": 2,
    "type": "Number"
  }
}'
orionCurl --url /v2/entities --payload "$payload"
echo
echo


echo '02. Create subscription for A, B, C with covered:true and onlyChangedAttrs:false'
echo '================================================================================'
payload='{
  "subject": {
    "entities": [
      {
        "id": "E",
        "type": "T"
      }
    ]
  },
  "notification": {
    "httpCustom": {
      "url": "http://localhost:'$LISTENER_PORT'/notify",
      "json": {
        "A": "${A}",
        "B": "${B}",
        "C": "${C}",
        "D": "${D}"
      }
    },
    "attrs": [
      "A",
      "B",
      "C",
      "D"
    ],
    "covered": true,
    "onlyChangedAttrs": false
  }
}'
orionCurl --url /v2/subscriptions --payload "$payload"
subId=$(echo "$_responseHeaders" | grep Location | awk -F/ '{ print $4 }' | tr -d "\r\n")
echo
echo


echo "03. Update E-T with A=11"
echo "========================"
payload='{
  "A": {
    "value": 11,
    "type": "Number"
  }
}'
orionCurl --url /v2/entities/E/attrs --payload "$payload"
echo
echo


echo "04. Dump & reset, see notifications A=11, B=2, C=null, D=null (context is not lost)"
echo "==================================================================================="
accumulatorDump
accumulatorReset
echo
echo


echo "05. Update subscription to A, B, C, D with covered:true and onlyChangedAttrs:true"
echo "================================================================================="
payload='{
  "notification": {
    "httpCustom": {
      "url": "http://localhost:'$LISTENER_PORT'/notify",
      "json": {
        "A": "${A}",
        "B": "${B}",
        "C": "${C}",
        "D": "${D}"
      }
    },
    "attrs": [
      "A",
      "B",
      "C",
      "D"
    ],
    "covered": true,
    "onlyChangedAttrs": true
  }
}'
orionCurl --url /v2/subscriptions/${subId} --payload "$payload" -X PATCH
echo
echo


sleep 1.5s


echo "06. Update E-T with A=111"
echo "========================"
payload='{
  "A": {
    "value": 111,
    "type": "Number"
  }
}'
orionCurl --url /v2/entities/E/attrs --payload "$payload"
echo
echo


echo "07. Dump & reset, see notifications A=111, B=2, C=null, D=null (context is not lost)"
echo "===================================================================================="
accumulatorDump
accumulatorReset
echo
echo


echo "08. Update subscription to A, B, C, D with covered:false and onlyChangedAttrs:true"
echo "=================================================================================="
payload='{
  "notification": {
    "httpCustom": {
      "url": "http://localhost:'$LISTENER_PORT'/notify",
      "json": {
        "A": "${A}",
        "B": "${B}",
        "C": "${C}",
        "D": "${D}"
      }
    },
    "attrs": [
      "A",
      "B",
      "C",
      "D"
    ],
    "covered": false,
    "onlyChangedAttrs": true
  }
}'
orionCurl --url /v2/subscriptions/${subId} --payload "$payload" -X PATCH
echo
echo


sleep 1.5s


echo "09. Update E-T with A=1111"
echo "=========================="
payload='{
  "A": {
    "value": 1111,
    "type": "Number"
  }
}'
orionCurl --url /v2/entities/E/attrs --payload "$payload"
echo
echo


echo "10. Dump & reset, see notifications A=1111, B=2, C=null, D=null (context is not lost)"
echo "====================================================================================="
accumulatorDump
accumulatorReset
echo
echo


echo "11. Update subscription to A, B, C, D with covered:false and onlyChangedAttrs:false"
echo "==================================================================================="
payload='{
  "notification": {
    "httpCustom": {
      "url": "http://localhost:'$LISTENER_PORT'/notify",
      "json": {
        "A": "${A}",
        "B": "${B}",
        "C": "${C}",
        "D": "${D}"
      }
    },
    "attrs": [
      "A",
      "B",
      "C",
      "D"
    ],
    "covered": false,
    "onlyChangedAttrs": false
  }
}'
orionCurl --url /v2/subscriptions/${subId} --payload "$payload" -X PATCH
echo
echo


sleep 1.5s


echo "12. Update E-T with A=11111"
echo "==========================="
payload='{
  "A": {
    "value": 11111,
    "type": "Number"
  }
}'
orionCurl --url /v2/entities/E/attrs --payload "$payload"
echo
echo


echo "13. Dump & reset, see notifications A=11111, B=2, C=null, D=null (context is not lost)"
echo "======================================================================================"
accumulatorDump
accumulatorReset
echo
echo


--REGEXPECT--
01. Create entity E-T with A, B
===============================
HTTP/1.1 201 Created
Date: REGEX(.*)
Fiware-Correlator: REGEX([0-9a-f\-]{36})
Location: /v2/entities/E?type=T
Content-Length: 0



02. Create subscription for A, B, C with covered:true and onlyChangedAttrs:false
================================================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Fiware-Correlator: REGEX([0-9a-f\-]{36})
Location: /v2/subscriptions/REGEX([0-9a-f]{24})
Content-Length: 0



03. Update E-T with A=11
========================
HTTP/1.1 204 No Content
Date: REGEX(.*)
Fiware-Correlator: REGEX([0-9a-f\-]{36})



04. Dump & reset, see notifications A=11, B=2, C=null, D=null (context is not lost)
===================================================================================
POST http://localhost:REGEX(\d+)/notify
Fiware-Servicepath: /
Content-Length: 32
User-Agent: orion/REGEX(\d+\.\d+\.\d+.*)
Ngsiv2-Attrsformat: custom
Host: localhost:REGEX(\d+)
Accept: application/json
Content-Type: application/json; charset=utf-8
Fiware-Correlator: REGEX([0-9a-f\-]{36}); cbnotif=1

{
    "A": 11,
    "B": 2,
    "C": null,
    "D": null
}
=======================================


