# VALGRIND_READY - to mark the test ready for valgrindTestSuite.sh

--NAME--
Check Connection failure notification logs severity and content

--SHELL-INIT--
dbInit CB
brokerStart CB
accumulatorStart --pretty-print

--SHELL--

#
# 01. Create subscription SUB (pointing to a port with nothing listening), matching E
# 02. Create entity E
# 03. Check logs to verify warning notification trace for Connection failure
#

echo "01. Create subscription SUB (pointing to a port with nothing listening)"
echo "========================================================================="
payload='{
  "subject": {
    "entities": [
      {
        "id": "E"
      }
    ]
  },
  "notification": {
    "http": {
      "url": "http://localhost:12345/notify"
    }
  }
}'
orionCurl --url /v2/subscriptions --payload "$payload"
echo
echo

SUB_ID=$(echo "$_responseHeaders" | grep Location | awk -F/ '{ print $4 }' | tr -d "\r\n")

echo "02. Create entity E"
echo "==================="
payload='{
  "id": "E",
  "type": "T",
  "A": 1
}'
orionCurl --url '/v2/entities?options=keyValues' --payload "$payload"
echo
echo

# Await notification sending and failure
sleep 1

echo "03. Check logs to verify warning notification trace for Connection failure"
echo "=========================================================================="
cat /tmp/contextBroker.log | grep 'WARN' | grep 'msg=Notif' | awk -F '|' '{print $2 $10}' | sed -e "s/$SUB_ID/SUB_ID/g"
echo
echo

--REGEXPECT--
01. Create subscription SUB (pointing to a port with nothing listening)
=========================================================================
HTTP/1.1 201 Created
Date: REGEX(.*)
Fiware-Correlator: REGEX([0-9a-f\-]{36})
Location: /v2/subscriptions/REGEX([0-9a-f]{24})
Content-Length: 0



02. Create entity E
===================
HTTP/1.1 201 Created
Date: REGEX(.*)
Fiware-Correlator: REGEX([0-9a-f\-]{36})
Location: /v2/entities/E?type=T
Content-Length: 0



03. Check logs to verify warning notification trace for Connection failure
==========================================================================
 lvl=WARN  msg=Notif failure (subId: SUB_ID): POST localhost:12345/notify, payload (122 bytes): {"subscriptionId":"SUB_ID","data":[{"id":"E","type":"T","A":{"type":"Number","value":1,"metadata":{}}}]}, response code: Could not connect to server


--TEARDOWN--
brokerStop CB
dbDrop CB
accumulatorStop
